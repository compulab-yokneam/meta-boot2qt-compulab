#!/bin/bash -e

SCRIPTS+=" https://raw.githubusercontent.com/compulab-yokneam/meta-boot2qt-compulab/nanbield-addon/scripts/meta-boot2qt-compulab.xml"

function update_environment() {
    push ${BUILDDIR}/../
    if [ -d ${BUILDDIR}/../.repo ];then

        for script in ${SCRIPTS};do
            [[ -f ${BUILDDIR}/../.repo/local_manifests/$(basename ${script}) ]] || wget --directory-prefix .repo/local_manifests ${script}
        done

        repo sync
    fi
    popd
}

[[ -z "${BUILDDIR}" ]] || update_environment
